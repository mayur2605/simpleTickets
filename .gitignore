node_modules/
dist/

# Server runtime data: archived raw messages, attachments, database backups and
# one-off exports. Real employee mail and real attachments live here - it is
# never committed, and it is what the daily backup exists to protect.
server/var/
.env
.env.*
!.env.example
playwright-report/
test-results/

# Smoke-test screenshot outputs, regenerated by every `npm test` run
prototype/*-preview.png

# Local credentials for talking to deployed workers. Never committed:
# regenerate rather than share, and rotate the worker secret to match.
.probe-token
*.probe-token
.admin-token
*.admin-token
