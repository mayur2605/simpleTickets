# Copy to .env, which is git-ignored.
#
# Named without a leading dot on purpose: the pre-commit hook blocks anything
# matching (^|/)\.env($|\.), and that rule is correct. A template called
# `.env.example` has exactly the shape of a real one, and a hook that has to
# tell them apart by content is a hook that eventually lets a real one through.

DATABASE_URL=postgresql://localhost:5432/simpletickets
PORT=8787

# The support mailbox. support@allcheckservices.com forwards here.
GMAIL_USER=simpleticketssupport@gmail.com
GMAIL_APP_PASSWORD=

# Outgoing mail. OFF unless this is exactly "on".
#
# Leave it off while developing against the real mailbox: ingestion is
# read-only and harmless, but sending would deliver a second acknowledgement
# to a real employee for a ticket the deployed system already answered.
MAIL_SEND=off

SUPPORT_ADDRESS=support@allcheckservices.com
ALLOWED_DOMAIN=allcheckservices.com

# Local file storage: raw messages, attachments, backups.
STORAGE_DIR=./var/storage
BACKUP_DIR=./var/backups

# Shared token for the operator routes (/status, /poll, /flush). Not a staff
# credential: it grants no identity, so it cannot be used to act as a person.
ADMIN_TOKEN=

# Where staff read tickets. Every notification links here (R15).
DASHBOARD_URL=http://localhost:8787

# Directory holding pg_dump and pg_restore. Homebrew installs PostgreSQL
# keg-only, so they are not on PATH by default, and a backup that fails nightly
# with "command not found" is one nobody notices until they need it.
PG_BIN=/opt/homebrew/opt/postgresql@18/bin
