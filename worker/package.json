{
  "name": "worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SimpleTickets backend: mail ingestion and ticket store.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "dry-run": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit && npm run dry-run",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260916.1",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "imapflow": "2.0.5",
    "prettier": "^3.9.7",
    "typescript": "6.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "5.0.1",
    "wrangler": "4.132.0"
  }
}
