{
  "name": "worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SimpleTickets backend: mail ingestion and ticket store.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "dry-run": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "verify": "npm run typecheck && npm run test:unit && npm run dry-run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260916.1",
    "imapflow": "2.0.5",
    "typescript": "6.0.2",
    "vitest": "5.0.1",
    "wrangler": "4.132.0"
  }
}
